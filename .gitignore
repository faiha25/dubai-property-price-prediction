# Virtual environment
venv/
.venv/
env/

# Data (never commit raw or processed data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained models — excluded by default (can be large/regeneratable),
# but the final tuned model is committed so the Streamlit demo (app.py)
# works from a fresh clone without requiring a local training run.
models/*
!models/.gitkeep
!models/best_model_xgboost.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Jupyter
.jupyter/

# OS
.DS_Store

# Editor
.vscode/
.idea/
